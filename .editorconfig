root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Hooks modules (TypeScript) and data: 2-space indentation, as Claude Code's examples
[*.{ts,tsx,js,mjs,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
